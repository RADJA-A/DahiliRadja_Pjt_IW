### Variables
@baseUrl = http://localhost:8082/api/evenements
@userId = 1
@evenementId = 1

###############################################
# TESTS POUR LES STATUTS AUTOMATIQUES
###############################################

### TEST 1 : Créer un événement qui se termine dans le FUTUR
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Événement FUTUR - Statut AVENIR attendu",
  "type": "CONFERENCE",
  "lieu": "Salle A",
  "dateDebut": "2025-12-31T14:00:00",
  "dateFin": "2025-12-31T18:00:00",
  "capaciteMax": 50,
  "organisateurId": 1
}

### TEST 2 : Créer un événement qui est EN COURS (dateDebut dans le passé, dateFin dans le futur)
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Événement EN COURS",
  "type": "FORMATION",
  "lieu": "Salle B",
  "dateDebut": "2024-01-01T10:00:00",  # Date dans le passé
  "dateFin": "2026-12-31T18:00:00",    # Date dans le futur
  "capaciteMax": 30,
  "organisateurId": 1
}

### TEST 3 : Créer un événement qui est TERMINE (toutes les dates dans le passé)
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Événement TERMINE - Toutes dates passées",
  "type": "CONCERT",
  "lieu": "Opéra",
  "dateDebut": "2024-06-01T20:00:00",
  "dateFin": "2024-06-01T23:00:00",
  "capaciteMax": 100,
  "organisateurId": 1
}

### TEST 4 : Créer un événement ANNULE
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Événement ANNULE",
  "type": "CONFERENCE",
  "lieu": "Salle C",
  "dateDebut": "2025-01-15T09:00:00",
  "dateFin": "2025-01-15T17:00:00",
  "capaciteMax": 80,
  "organisateurId": 1
}

### TEST 5 : Mettre à jour l'événement 4 en ANNULE
PUT {{baseUrl}}/4
Content-Type: application/json
User-Id: {{userId}}

{
  "statut": "ANNULE"
}

### TEST 6 : Vérifier le statut des événements créés
GET {{baseUrl}}

### TEST 7 : Vérifier un événement spécifique FUTUR
GET {{baseUrl}}/1

### TEST 8 : Vérifier un événement spécifique TERMINE
GET {{baseUrl}}/3

### TEST 9 : Vérifier un événement spécifique ANNULE
GET {{baseUrl}}/4

###############################################
# TEST 10 : Créer événement avec date de fin DANS 1 MINUTE
# (Pour tester le changement automatique de statut)
###############################################
# Calculer la date dans 1 minute
# Utilisez ceci si votre client HTTP supporte les variables dynamiques
# Sinon, remplacez par des dates fixes
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Test changement statut automatique",
  "type": "CONFERENCE",
  "lieu": "Salle de test",
  "dateDebut": "2024-01-01T10:00:00",
  "dateFin": "2024-01-01T10:01:00",  # Se termine dans 1 minute
  "capaciteMax": 10,
  "organisateurId": 1
}

###############################################
# TEST 11 : Forcer la mise à jour manuelle des statuts
# (Appelle la méthode @Scheduled manuellement)
###############################################
POST {{baseUrl}}/update-status

### TEST 12 : Vérifier si les statuts ont été mis à jour
GET {{baseUrl}}

###############################################
# TEST 13 : Incrémenter jusqu'à capacité max pour voir le statut changer

POST http://localhost:8082/api/evenements/status/update
###############################################
# Créer un petit événement pour le test
POST {{baseUrl}}
Content-Type: application/json

{
  "titre": "Test capacité max",
  "type": "FORMATION",
  "lieu": "Petite salle",
  "dateDebut": "2025-12-20T10:00:00",
  "dateFin": "2025-12-20T12:00:00",
  "capaciteMax": 3,
  "organisateurId": 1
}

### Obtenir l'ID du nouvel événement
GET {{baseUrl}}

### Incrémenter 1ère inscription
POST {{baseUrl}}/6/incrementer-inscrits

### Incrémenter 2ème inscription
POST {{baseUrl}}/6/incrementer-inscrits

### Incrémenter 3ème inscription (capacité max atteinte)
POST {{baseUrl}}/6/incrementer-inscrits

### Vérifier que le statut est passé à TERMINE (car capacité max atteinte)
GET {{baseUrl}}/6

### TEST 14 : Décrémenter pour voir le statut revenir
POST {{baseUrl}}/6/decrementer-inscrits

### Vérifier que le statut est revenu à AVENIR
GET {{baseUrl}}/6

