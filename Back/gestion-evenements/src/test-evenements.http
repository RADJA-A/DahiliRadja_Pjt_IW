Content-Type: application/json

{
  "titre": "Événement annulé dans le passé",
  "type": "CONFERENCE",
  "lieu": "Salle annulée",
  "dateDebut": "2024-01-01T09:00:00",
  "dateFin": "2024-01-01T10:00:00",
  "capaciteMax": 10,
  "organisateurId": 1,
  "statut": "ANNULE"
}



