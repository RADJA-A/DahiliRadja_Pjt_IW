### Variables
@baseUrl = http://localhost:8084/api/inscriptions
@userId = 1
@evenementId = 1

###############################################
# verifie les participant a l'evenement 12
GET {{baseUrl}}/evenement/12
# PARTICIPANT : S'inscrire à un événement
###############################################
POST {{baseUrl}}
Content-Type: application/json

{
  "userId": 1,
  "evenementId": 1
}

###############################################
# PARTICIPANT : S'inscrire à un autre événement
###############################################
POST {{baseUrl}}
Content-Type: application/json

{
  "userId": 1,
  "evenementId": 2
}

###############################################
# PARTICIPANT : Voir mes inscriptions
###############################################
GET {{baseUrl}}/user/1

###############################################
# PARTICIPANT : Se désinscrire
###############################################
DELETE {{baseUrl}}/19

###############################################
DELETE http://localhost:8084/api/inscriptions/45
# ORGANISATEUR : Voir les participants de mon événement
###############################################
GET {{baseUrl}}/evenement/1

###############################################
# TEST COMPLET : Workflow avec 3 microservices
###############################################

### Étape 1 : Créer un événement (Microservice Événements)
POST http://localhost:8082/api/evenements
Content-Type: application/json

{
  "titre": "Test Inscription",
  "type": "CONCERT",
  "lieu": "Salle A",
  "dateDebut": "2025-12-20T10:00:00",
  "dateFin": "2025-12-20T16:00:00",
  "capaciteMax": 50,
  "organisateurId": 2
}

### Étape 2 : S'inscrire à cet événement (Microservice Inscriptions)
POST {{baseUrl}}
Content-Type: application/json

{
  "userId": 2,
  "evenementId": 2
}

### Étape 3 : Vérifier les notifications (Microservice Notifications)
GET http://localhost:8083/api/notifications/user/1

### Étape 4 : Vérifier que le nombre d'inscrits a augmenté
GET http://localhost:8082/api/evenements/1

### Étape 5 : Se désinscrire
DELETE {{baseUrl}}/2

### Étape 6 : Vérifier les nouvelles notifications
GET http://localhost:8083/api/notifications/user/1

### Étape 7 : Vérifier que le nombre d'inscrits a diminué
GET http://localhost:8082/api/evenements/1


